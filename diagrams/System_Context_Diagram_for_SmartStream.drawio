      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n!pragma layout smetana\nskinparam componentStyle rectangle\n\n&#39; Define the external entities (Rectangles)\nrectangle \&quot;Director\&quot; as Dir\nrectangle \&quot;Distributor\&quot; as Dist\nrectangle \&quot;Stock Manager\&quot; as SM\nrectangle \&quot;Accountant\&quot; as Acc\nrectangle \&quot;System Admin\&quot; as Admin\nrectangle \&quot;Email/SMS Gateway API\&quot; as API\n\n&#39; Define the main system (Circle/Oval)\nusecase \&quot;SmartStream\\nIntegrated Business\\nManagement System\&quot; as System\n\n&#39; Draw the data flows (Arrows)\nDist --&gt; System : Invoice Images, GPS Location\nSystem --&gt; Dist : Delivery Routes, App Alerts\n\nSM --&gt; System : Inventory Adjustments\nSystem --&gt; SM : Inventory Reports\n\nSystem --&gt; Dir : Financial Reports, Dashboard Data\nDir --&gt; System : Query Requests\n\nSystem --&gt; Acc : Unapproved Invoices, Ledger Data\nAcc --&gt; System : Invoice Approvals\n\nAdmin --&gt; System : RBAC Updates, System Configs\nSystem --&gt; Admin : System Logs, Backup Status\n\nSystem --&gt; API : Low Stock Alert Triggers\nAPI --&gt; SM : (Delivers external SMS/Email)\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="r1Nt8U0InX8paQAvdc6R-3">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
